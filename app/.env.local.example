# Local development. Copy to .env.local (git-ignored).
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Local Postgres without TLS (docker compose up -d db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itam
DB_USER=itam_master
DB_PASSWORD=devpass
DB_SSL=off

# Local sign-in without Cognito. Refused when NODE_ENV=production.
DEV_AUTH=1

# Optional locally; required in AWS
# S3_BUCKET=
# ALERT_TOPIC_ARN=
